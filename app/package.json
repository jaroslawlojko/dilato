{
  "name": "app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.26",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "cross-env TZ=Europe/Warsaw NODE_OPTIONS=--disable-warning=ExperimentalWarning jest",
    "test:coverage": "cross-env TZ=Europe/Warsaw NODE_OPTIONS=--disable-warning=ExperimentalWarning jest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "src/domain/**/*.ts",
      "src/data/**/*.ts",
      "!src/domain/index.ts",
      "!src/domain/testing/**",
      "!src/data/testing/**",
      "!src/data/drivers/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 95,
        "branches": 85
      }
    }
  }
}
